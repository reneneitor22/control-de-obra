# ===== Cabeceras de seguridad (aplican a todo /finanzas/) =====
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "same-origin"
</IfModule>

# ===== Bloquear acceso web a archivos sensibles del proyecto =====
<FilesMatch "^(config\.php|config\.local\.php.*|schema\.sql|.*\.sqlite.*|composer\.(json|lock)|package(-lock)?\.json)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>

# ===== Bloquear la carpeta de datos =====
<IfModule mod_authz_core.c>
  <If "%{REQUEST_URI} =~ m#/data/#">
    Require all denied
  </If>
</IfModule>

RewriteEngine On
RewriteRule ^data/ - [F,L]

RewriteBase /finanzas/
RewriteRule ^$ public/ [L]
RewriteCond %{REQUEST_URI} !^/finanzas/public/
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.*)$ public/$1 [L]
